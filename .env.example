# ---------------------------------------------------------------------------
# QUORUM configuration. Every variable is optional for local development:
# with none set, the app runs on an embedded Postgres (PGlite, stored in .pglite/)
# with simulated payments and sign-in codes shown on screen.
# ---------------------------------------------------------------------------

# Public URL of the site, used in emails and share links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string. Required on Vercel. For Supabase use the
# transaction pooler (port 6543). Leave unset locally to use PGlite.
DATABASE_URL=

# 32+ random bytes. Signs login codes. `openssl rand -base64 32`
AUTH_SECRET=

# Comma-separated emails that can open /admin.
ADMIN_EMAILS=

# Stripe. Leave the secret key unset to run in demo mode (no card is touched).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# Email via Resend. Unset = emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="QUORUM <union@yourdomain.com>"

# Vercel Cron sends this as a bearer token to /api/cron/settle.
CRON_SECRET=

# Load sample drops into an EMPTY database on first boot. For preview deployments;
# turn it off and run `npm run db:reset` before launch.
SEED_DEMO=false
