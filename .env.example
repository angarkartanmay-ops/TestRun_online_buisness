# ---------------------------------------------------------------------------
# QUORUM configuration. Every variable is optional for local development:
# with none set, the app runs on an embedded Postgres (PGlite, stored in .pglite/)
# in practice mode (nobody pays) with sign-in codes shown on screen.
# See docs/DEPLOY.md for the order to switch things on.
# ---------------------------------------------------------------------------

# Public URL of the site, used in emails and share links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string. Required on Vercel. For Supabase use the
# transaction pooler (port 6543). Leave unset locally to use PGlite.
DATABASE_URL=

# 32+ random bytes. Signs login codes. `openssl rand -base64 32`
AUTH_SECRET=

# Comma-separated emails that can open /admin.
ADMIN_EMAILS=

# Market. INR and IST by default; usd/gbp for a later US/UK deployment.
NEXT_PUBLIC_CURRENCY=inr
NEXT_PUBLIC_TIME_ZONE=Asia/Kolkata

# Pay after close (India). Joining is a promise; members pay the final price once
# a drop clears. UPI_VPA alone = UPI link + QR, marked paid by the admin (friends
# test only). Razorpay keys = a payment link per member, marked paid by the webhook.
UPI_VPA=
UPI_PAYEE_NAME=QUORUM
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe card holds (US/UK later — Stripe is invite-only in India).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Shown on /legal/grievance. Required before the first paid drop (E-Commerce Rules 2020).
SELLER_NAME=
SELLER_ADDRESS=
GRIEVANCE_NAME=
GRIEVANCE_EMAIL=

# Email via Resend. Unset = emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="QUORUM <union@yourdomain.com>"

# Vercel Cron sends this as a bearer token to /api/cron/settle.
CRON_SECRET=

# Practice drops: labelled, simulated members, nobody pays. `true` keeps four open
# at all times (the daily cron and an empty homepage restock them).
SEED_DEMO=false
